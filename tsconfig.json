{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "src/**/*", "site/**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "checkJs": false,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "site/*": ["site/*"]
    }
  }
}
