---
import type { HomeSlotProps } from '@antv/site';
import { Carousel, QaEntry, Updates } from '@antv/site/components';
import antdVisual from './assets/home/antd.svg?url';
import avaVisual from './assets/home/ava.svg?url';
import contextVisual from './assets/home/context.png?url';
import gptVisVisual from './assets/home/gpt-vis.svg?url';
import heroBackground from './assets/home/hero-background.png?url';
import heroEffect from './assets/home/hero-effect.gif?url';
import infographicVisual from './assets/home/infographic.svg?url';
import mcpVisual from './assets/home/mcp.svg?url';
import siveVisual from './assets/home/sive.svg?url';
import skillsVisual from './assets/home/skills.svg?url';
import {
  aiSolutions,
  ecosystem,
  experts,
  foundation,
  showcases,
} from './data/home';

type Props = HomeSlotProps;

const { locale } = Astro.props;
const isZh = locale === 'zh';
const text = {
  heroTitle: isZh ? '让 AI 栩栩如生' : 'Make AI come alive',
  heroDescription: isZh
    ? '蚂蚁企业级数据可视化解决方案，让人们在数据世界里获得视觉化思考能力。'
    : 'Enterprise visualization technology that helps people think visually in a world of data.',
  updatesTitle: isZh ? 'AntV 最新动态' : 'Latest from AntV',
  aiTitle: isZh ? 'AI 可视化方案' : 'AI visualization solutions',
  aiDescription: isZh
    ? '从产品知识、专业技能到工具连接与数据理解，形成完整的 AI 可视化工作流。'
    : 'A complete workflow spanning product knowledge, reusable skills, connected tools, and data understanding.',
  performanceTitle: isZh ? '卓越性能、自在表达' : 'High performance, expressive by design',
  performanceDescription: isZh
    ? '定制主题、一键生成、性能飞跃、专业优雅、丰富图表、选用自如。'
    : 'Custom themes, fast generation, high performance, and expressive charts for every use case.',
  matrixTitle: isZh ? '产品矩阵' : 'Product matrix',
  aiAgent: 'AntV AI Agent',
  designLanguage: isZh ? 'AntV Design 设计语言' : 'AntV Design language',
  expertsTitle: isZh ? '专家之声' : 'Expert voices',
};

const metrics = [
  { value: '10+', suffix: isZh ? '年' : 'years', label: isZh ? '可视化技术积累' : 'of visualization practice' },
  { value: isZh ? '72+' : '720K+', suffix: isZh ? '万' : '', label: 'GitHub Stars' },
  { value: isZh ? '15+' : '1.5B+', suffix: isZh ? '亿' : '', label: isZh ? '年度 NPM 下载' : 'annual NPM downloads' },
];
const solutionVisuals: Record<string, string> = {
  Context: contextVisual,
  Skills: skillsVisual,
  MCP: mcpVisual,
  AVA: avaVisual,
  'GPT Vis': gptVisVisual,
  Infographic: infographicVisual,
};
const matrixAgentDescriptions = isZh
  ? ['知识召回', '专业技能', '生态链接', '智能洞察']
  : ['Context retrieval', 'Specialist skills', 'Ecosystem links', 'Intelligent insights'];
const matrixGptVisDescription = isZh ? '数据分析图表库' : 'Data analysis chart library';
---

<div class:list={['antv-home', !isZh && 'antv-home-en']}>
  <section class="antv-hero" aria-labelledby="antv-home-title" data-antv-scene>
    <picture class="antv-hero-media" aria-hidden="true">
      <source media="(prefers-reduced-motion: reduce)" srcset={heroBackground} />
      <img src={heroEffect} alt="" width="1440" height="577" decoding="async" fetchpriority="high" />
    </picture>
    <div class="antv-hero-copy" data-antv-item>
      <h1 id="antv-home-title" data-pagefind-meta="title">
        <span class="antv-wordmark">AntV</span><span aria-hidden="true">·</span>{text.heroTitle}
      </h1>
      <p class="antv-hero-description">{text.heroDescription}</p>
      <QaEntry locale={locale} />
    </div>
  </section>

  <section class="antv-signal" aria-labelledby="antv-updates-title" data-antv-scene>
    <h2 id="antv-updates-title" class="antv-visually-hidden">{text.updatesTitle}</h2>
    <div class="antv-signal-inner">
      <div class="antv-metrics" data-antv-item>
        {metrics.map((metric) => (
          <div class="antv-metric">
            <p><strong>{metric.value}</strong><span>{metric.suffix}</span></p>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
      <div class="antv-updates-placement">
        <Updates locale={locale} />
      </div>
    </div>
  </section>

  <section id="ai-solutions" class="antv-ai-solutions" aria-labelledby="antv-ai-title" data-antv-scene>
    <div class="antv-section-inner">
      <header class="antv-section-heading antv-ai-heading" data-antv-item>
        <h2 id="antv-ai-title">{text.aiTitle}</h2>
        <p>{text.aiDescription}</p>
      </header>
      <div class="antv-solution-grid">
        {aiSolutions.map((item, index) => (
          <a
            class="antv-solution-card"
            href={item.href}
            target="_blank"
            rel="noreferrer"
            data-antv-item
            style={`--antv-index:${index}`}
          >
            <span class="antv-solution-topline">
              <strong>{item.label}</strong>
              <span class="antv-solution-icon"><img src={solutionVisuals[item.label || '']} alt="" aria-hidden="true" loading="lazy" /></span>
            </span>
            <span class="antv-solution-title">{item.title[locale]}</span>
            <span class="antv-solution-description">{item.description[locale]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="products" class="antv-showcase" aria-labelledby="antv-performance-title" data-antv-scene>
    <div class="antv-section-inner">
      <header class="antv-section-heading" data-antv-item>
        <h2 id="antv-performance-title">{text.performanceTitle}</h2>
        <p>{text.performanceDescription}</p>
      </header>
      <div class="antv-showcase-grid">
        {showcases.map((item, index) => {
          const titleNote = item.titleNote?.[locale];
          return (
            <a
              class="antv-showcase-card"
              href={item.href}
              target="_blank"
              rel="noreferrer"
              data-antv-item
              style={`--antv-index:${index}`}
            >
              <figure class:list={['antv-showcase-media', item.mediaTone === 'dark' && 'antv-showcase-media-dark']}>
                <div class="antv-showcase-media-inner">
                  <img
                    src={item.image}
                    alt={`${item.product} ${item.title[locale]}${titleNote ?? ''}${isZh ? '示例' : ' example'}`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </figure>
              <span class="antv-showcase-copy">
                <span class="antv-showcase-title-row">
                  <strong>
                    {item.title[locale]}
                    {titleNote && <> <span class="antv-showcase-title-note">{titleNote}</span></>}
                  </strong>
                  <small>{item.product}</small>
                </span>
                <span>{item.description[locale]}</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="antv-matrix" aria-labelledby="antv-matrix-title" data-antv-scene>
    <div class="antv-section-inner">
      <header class="antv-section-heading antv-matrix-heading" data-antv-item>
        <h2 id="antv-matrix-title">{text.matrixTitle}</h2>
      </header>
      <div class="antv-matrix-board" data-antv-item>
        <a class="antv-matrix-sive" href={ecosystem[0].href} target="_blank" rel="noreferrer">
          <span class="antv-matrix-product-mark"><img src={siveVisual} alt="" aria-hidden="true" loading="lazy" /></span>
          <strong>{ecosystem[0].name} <span aria-hidden="true">·</span> {ecosystem[0].description[locale]}</strong>
        </a>
        <div class="antv-matrix-agent">
          <strong>{text.aiAgent}</strong>
          <div>
            {aiSolutions.slice(0, 4).map((item, index) => (
              <a href={item.href} target="_blank" rel="noreferrer"><b>{item.label}</b><span>{matrixAgentDescriptions[index]}</span></a>
            ))}
          </div>
        </div>
        <div class="antv-matrix-ecosystem">
          <a href={ecosystem[1].href} target="_blank" rel="noreferrer">
            <span class="antv-matrix-product-mark"><img src={antdVisual} alt="" aria-hidden="true" loading="lazy" /></span>
            <strong>{ecosystem[1].name} <span>{ecosystem[1].description[locale]}</span></strong>
          </a>
          <a href={aiSolutions[4].href} target="_blank" rel="noreferrer">
            <span class="antv-matrix-product-mark"><img src={gptVisVisual} alt="" aria-hidden="true" loading="lazy" /></span>
            <strong>{aiSolutions[4].label} <span>{matrixGptVisDescription}</span></strong>
          </a>
        </div>
        <div class="antv-matrix-foundation">
          {foundation.map(([name, zhDescription, enDescription, href]) => (
            <a href={href} target="_blank" rel="noreferrer"><strong>{name}</strong><span>{isZh ? zhDescription : enDescription}</span></a>
          ))}
        </div>
        <a class="antv-matrix-design" href={`/${locale}/specification/principles/basic/`}>
          <strong>{text.designLanguage}</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="antv-experts" aria-labelledby="antv-experts-title" data-antv-scene>
    <div class="antv-section-inner">
      <header class="antv-section-heading antv-section-heading-compact antv-expert-heading" data-antv-item>
        <h2 id="antv-experts-title">{text.expertsTitle}</h2>
      </header>
      <div class="antv-expert-carousel">
        <Carousel
          locale={locale}
          label={text.expertsTitle}
          pageLabel={isZh ? '查看第 {page} 组专家之声' : 'View expert voices group {page}'}
          list
        >
          {experts.map((expert, index) => (
            <article class="antv-expert-card" role="listitem" data-antv-item style={`--antv-index:${index}`}>
              <div class="antv-expert-person">
                <img src={expert.image} alt={expert.name} loading="lazy" decoding="async" />
                <div><h3>{expert.name}</h3><p>{expert.role[locale]}</p></div>
              </div>
              <blockquote>{expert.quote[locale]}</blockquote>
            </article>
          ))}
        </Carousel>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (() => {
    const sections = [...document.querySelectorAll('[data-antv-scene]')];
    const reveal = (section) => section.setAttribute('data-antv-visible', '');
    document.documentElement.classList.add('antv-home-motion');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sections.forEach(reveal);
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        reveal(entry.target);
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    sections.forEach((section, index) => index === 0 ? reveal(section) : observer.observe(section));
  })();
</script>

<style>
  @font-face {
    font-family: 'AntV Home Light';
    src: url('./assets/home/fonts/home-light.woff2') format('woff2');
    font-weight: 300;
    font-display: swap;
  }

  @font-face {
    font-family: 'AntV Metrics';
    src: url('./assets/home/fonts/metrics-bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }
  .antv-home {
    --antv-home-width: min(1180px, calc(100% - 64px));
    --antv-copy-font: 'AntV Home Light', var(--font-sans);
    --antv-card-radius: 18px;
    --antv-card-padding: 15px;
    --antv-inner-radius: 12px;
    /* Native Sketch page fill and shared AI/product-matrix surface. */
    --antv-page: #fbfbfc;
    --antv-section: #f6f4fd;
    --antv-card: rgb(255 254 255 / 92%);
    --antv-card-solid: #F8F7FD;
    --antv-line: #e7ddf6;
    --antv-purple-line: #d8c3ff;
    --antv-shadow: 0 16px 42px rgb(88 49 156 / 9%);
    --antv-shadow-hover: 0 22px 50px rgb(88 49 156 / 14%);
    overflow: hidden;
    color: var(--text);
    background: var(--antv-page);
  }

  .antv-updates-placement { margin-top: 100px; }

  @media (max-width: 767px) {
    .antv-updates-placement { margin-top: 34px; }
  }

  .antv-section-inner,
  .antv-signal-inner {
    width: var(--antv-home-width);
    margin: 0 auto;
  }

  .antv-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .antv-hero {
    position: relative;
    display: flex;
    min-height: 577px;
    justify-content: center;
    overflow: hidden;
    background: #eee7ff;
  }

  .antv-hero-media,
  .antv-hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .antv-hero-media img {
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .antv-hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(820px, calc(100% - 40px));
    align-items: center;
    flex-direction: column;
    padding-top: clamp(48px, 4.2vw, 60px);
    text-align: center;
  }

  .antv-hero h1,
  .antv-section-heading h2 {
    margin: 0;
    color: #17141d;
    letter-spacing: -.04em;
  }

  .antv-home h1,
  .antv-home h2 {
    font-weight: 900;
  }

  .antv-hero h1 {
    max-width: 100%;
    font-size: clamp(58px, 4.31vw, 62px);
    line-height: 73.44px;
    letter-spacing: 0;
    color: #000;
    white-space: nowrap;
  }

  .antv-wordmark {
    color: #6e27ff;
  }

  .antv-hero-description {
    max-width: 698px;
    margin: 16px 0 0;
    color: #666;
    font-family: var(--antv-copy-font);
    font-size: 18px;
    font-weight: 300;
    line-height: 26.4px;
  }

  .antv-solution-card:focus-visible,
  .antv-showcase-card:focus-visible,
  .antv-matrix-board a:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--brand) 50%, transparent);
    outline-offset: 3px;
  }

  .antv-signal {
    position: relative;
    z-index: 3;
    overflow: hidden;
    margin-top: -47px;
    padding: 106px 0 55px;
    background: transparent;
  }

  .antv-signal::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(251 251 252 / 0%) 0,
      var(--antv-page) 47px
    );
    content: '';
    pointer-events: none;
  }

  .antv-signal::after {
    position: absolute;
    inset: 0;
    background: url('./assets/home/signal-background.svg') center / 100% 100% no-repeat;
    content: '';
    pointer-events: none;
  }

  .antv-signal-inner {
    position: relative;
    z-index: 2;
  }

  .antv-metrics {
    display: grid;
    width: min(736px, 100%);
    grid-template-columns: repeat(3, 128px);
    justify-content: space-between;
    margin: 0 auto;
  }

  .antv-metric {
    position: relative;
    min-height: 113px;
    padding: 0;
    text-align: center;
  }

  .antv-metric + .antv-metric::before {
    position: absolute;
    top: 17px;
    bottom: 0;
    left: -88px;
    border-left: 1px solid #ede6fa;
    content: '';
  }

  .antv-metric p {
    display: flex;
    height: 82px;
    align-items: flex-start;
    justify-content: center;
    margin: 0;
    color: #6e27ff;
  }

  .antv-metric strong {
    font-family: 'AntV Metrics', var(--font-sans);
    font-size: 64px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 82px;
  }

  .antv-metric p span {
    margin: 46px 0 0 8px;
    font-size: 18px;
    font-weight: 500;
    line-height: 24px;
  }

  .antv-metric > span {
    display: block;
    margin-top: 7px;
    color: #666;
    font-family: var(--antv-copy-font);
    font-size: 16px;
    font-weight: 300;
    line-height: 24px;
  }

  .antv-solution-grid::-webkit-scrollbar {
    display: none;
  }

  .antv-solution-card,
  .antv-showcase-card {
    color: inherit;
    text-decoration: none;
    transition: border-color .25s, box-shadow .25s, transform .25s;
  }

  .antv-solution-card:hover {
    background:
      linear-gradient(180deg, #b39aff 0%, rgb(255 255 255 / 0%) 100%),
      linear-gradient(180deg, #fff 0%, #fafafa 100%);
  }

  .antv-solution-card:active,
  .antv-showcase-card:active,
  .antv-matrix-board a:active {
    transform: translateY(-1px) scale(.99);
  }

  .antv-ai-solutions,
  .antv-showcase,
  .antv-matrix,
  .antv-experts {
    position: relative;
    padding: 96px 0;
  }

  .antv-ai-solutions {
    overflow: hidden;
    padding: 155px 0 118px;
    background: var(--antv-section);
  }

  /* Sketch-rendered decorations preserve alpha masks lost by its SVG exporter. */
  .antv-ai-solutions::before,
  .antv-showcase::before,
  .antv-matrix::before {
    position: absolute;
    top: 0;
    left: calc(50% - 472px);
    width: 910px;
    height: 318px;
    background: center / 100% 100% no-repeat;
    content: '';
    pointer-events: none;
  }

  .antv-ai-solutions::before {
    background-image: url('./assets/home/ai-heading.webp');
  }

  .antv-section-heading {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto 42px;
    text-align: center;
  }

  .antv-section-heading-compact {
    margin-bottom: 38px;
  }

  .antv-section-heading h2 {
    color: #000;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 59px;
  }

  .antv-section-heading p {
    max-width: 650px;
    margin: 14px auto 0;
    color: #666;
    font-family: var(--antv-copy-font);
    font-size: 18px;
    font-weight: 300;
    line-height: 25px;
  }

  .antv-ai-heading {
    width: 100%;
    max-width: 720px;
    margin: 0 auto 88px;
    text-align: center;
  }

  .antv-ai-heading h2,
  .antv-matrix-heading h2 {
    font-size: 42px;
    letter-spacing: 0;
    line-height: 59px;
  }

  .antv-ai-heading p {
    display: none;
  }

  .antv-solution-grid {
    position: relative;
    z-index: 1;
    display: grid;
    width: 100%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-left: 0;
    overflow: visible;
  }

  .antv-solution-card {
    position: relative;
    display: flex;
    min-height: 270px;
    flex-direction: column;
    overflow: hidden;
    padding: 46px 40px 30px;
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 90%), rgb(250 250 250 / 27%)),
      #f4f1f9;
    box-shadow: inset 0 0 0 1px rgb(151 151 151 / 12%), 0 10px 30px #f0ebf6;
  }

  .antv-solution-card::before {
    position: absolute;
    inset: 0;
    background: url('./assets/home/solution-grid.webp') center / 100% 100% no-repeat;
    content: '';
    pointer-events: none;
  }

  .antv-solution-card > * {
    position: relative;
    z-index: 1;
  }

  .antv-solution-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-right: 6px;
  }

  .antv-solution-topline > strong {
    color: #000;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 37px;
  }

  .antv-solution-icon {
    display: grid;
    width: 58px;
    height: 58px;
    flex: 0 0 auto;
    place-items: center;
  }

  .antv-solution-icon img {
    width: 70px;
    height: 70px;
    max-width: none;
    object-fit: contain;
    transform: translateY(4px);
  }

  .antv-solution-title {
    position: relative;
    margin-top: 32px;
    color: #666;
    font-family: var(--antv-copy-font);
    font-size: 16px;
    font-weight: 300;
    line-height: 32px;
  }

  .antv-solution-description {
    position: relative;
    margin-top: 7px;
    padding-right: 0;
    color: #666;
    font-family: var(--antv-copy-font);
    font-size: 16px;
    font-weight: 300;
    line-height: 30px;
  }

  .antv-solution-title::before,
  .antv-solution-description::before {
    position: absolute;
    top: 14px;
    left: -11px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #6b22ff;
    content: '';
  }

  .antv-solution-card > .antv-link-icon {
    position: absolute;
    z-index: 1;
    right: 22px;
    bottom: 20px;
  }

  .antv-showcase {
    isolation: isolate;
    overflow: hidden;
    padding: 156px 0 50px;
    background: linear-gradient(180deg, transparent 38px, var(--antv-page) 38px, var(--antv-section) 97.5%);
  }

  .antv-showcase .antv-section-heading {
    margin-bottom: 65px;
  }

  .antv-showcase .antv-section-heading h2 {
    font-size: 42px;
    line-height: 59px;
  }

  .antv-showcase .antv-section-heading p {
    margin-top: 20px;
    font-size: 18px;
    line-height: 25px;
  }

  .antv-showcase::before {
    background-image: url('./assets/home/showcase-heading.webp');
  }

  .antv-showcase > .antv-section-inner,
  .antv-matrix > .antv-section-inner {
    position: relative;
    z-index: 1;
  }

  .antv-showcase-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
  }

  .antv-showcase-card {
    container-type: inline-size;
    display: flex;
    min-width: 0;
    height: 396px;
    flex-direction: column;
    grid-column: span 3;
    overflow: hidden;
    border-radius: 20px;
