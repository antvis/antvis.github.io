---
import arrowUpRightIcon from '@tabler/icons/outline/arrow-up-right.svg?raw';
import appsIcon from '@tabler/icons/outline/apps.svg?raw';
import hierarchyIcon from '@tabler/icons/outline/hierarchy-3.svg?raw';
import stackIcon from '@tabler/icons/outline/stack-2.svg?raw';
import type { HomeSlotProps } from '@antv/site';
import QaEntry from '@antv/site/qa-entry';
import aiBackground from './assets/home/ai-background.png?url';
import antvVisual from './assets/home/antv.svg?url';
import avaVisual from './assets/home/ava.svg?url';
import columnVisual from './assets/home/column.svg?url';
import contextVisual from './assets/home/context.png?url';
import gptVisVisual from './assets/home/gpt-vis.svg?url';
import heroBackground from './assets/home/hero-background.png?url';
import heroEffect from './assets/home/hero-effect.gif?url';
import infographicVisual from './assets/home/infographic.svg?url';
import mcpVisual from './assets/home/mcp.svg?url';
import pieVisual from './assets/home/pie.svg?url';
import siveVisual from './assets/home/sive.svg?url';
import skillsVisual from './assets/home/skills.svg?url';
import treemapVisual from './assets/home/treemap.svg?url';
import weavefoxVisual from './assets/home/weavefox.svg?url';
import {
  aiSolutions,
  ecosystem,
  experts,
  foundation,
  showcases,
  updates,
} from './data/home';

type Props = HomeSlotProps;

const { locale } = Astro.props;
const isZh = locale === 'zh';
const text = {
  heroTitle: isZh ? '让 AI 栩栩如生' : 'Make AI come alive',
  heroDescription: isZh
    ? '蚂蚁企业级数据可视化解决方案，让人们在数据世界里获得视觉化思考能力。'
    : 'Enterprise visualization technology that helps people think visually in a world of data.',
  updatesTitle: isZh ? 'AntV 最新动态' : 'Latest from AntV',
  aiTitle: isZh ? 'AI 可视化方案' : 'AI visualization solutions',
  aiDescription: isZh
    ? '从产品知识、专业技能到工具连接与数据理解，形成完整的 AI 可视化工作流。'
    : 'A complete workflow spanning product knowledge, reusable skills, connected tools, and data understanding.',
  performanceTitle: isZh ? '卓越性能、自在表达' : 'High performance, expressive by design',
  performanceDescription: isZh
    ? '从统计图表到信息图，选择适合场景的技术栈，直接打开真实示例。'
    : 'Choose the right technology for each visual expression and open a working example.',
  matrixTitle: isZh ? '产品矩阵' : 'Product matrix',
  matrixDescription: isZh
    ? '从设计语言与底层引擎，到图表、图编辑和 AI Agent，共享同一套开放技术基础。'
    : 'A shared open foundation spanning design, engines, charts, diagramming, and AI agents.',
  aiAgent: 'AntV AI Agent',
  ecosystem: isZh ? '周边生态' : 'Ecosystem',
  foundation: isZh ? '可视化技术栈' : 'Visualization stack',
  designLanguage: isZh ? 'AntV Design 设计语言' : 'AntV Design language',
  expertsTitle: isZh ? '专家之声' : 'Expert voices',
};

const metrics = [
  { value: '10+', suffix: isZh ? '年' : 'years', label: isZh ? '可视化技术积累' : 'of visualization practice' },
  { value: isZh ? '72+' : '720K+', suffix: isZh ? '万' : '', label: 'GitHub Stars' },
  { value: isZh ? '15+' : '1.5B+', suffix: isZh ? '亿' : '', label: isZh ? '年度 NPM 下载' : 'annual NPM downloads' },
];
const updateVisuals = [siveVisual, weavefoxVisual, antvVisual];
const solutionVisuals: Record<string, string> = {
  Context: contextVisual,
  Skills: skillsVisual,
  MCP: mcpVisual,
  AVA: avaVisual,
  'GPT Vis': gptVisVisual,
  Infographic: infographicVisual,
};
const showcaseDecorations = [columnVisual, pieVisual, treemapVisual];
const matrixDecorations = [hierarchyIcon, appsIcon, stackIcon];
---

<div class:list={['antv-home', !isZh && 'antv-home-en']}>
  <section class="antv-hero" aria-labelledby="antv-home-title" data-antv-scene>
    <picture class="antv-hero-media" aria-hidden="true">
      <source media="(prefers-reduced-motion: reduce)" srcset={heroBackground} />
      <img src={heroEffect} alt="" width="1440" height="577" decoding="async" fetchpriority="high" />
    </picture>
    <div class="antv-hero-copy" data-antv-item>
      <h1 id="antv-home-title" data-pagefind-meta="title">
        <span class="antv-wordmark">AntV</span><span aria-hidden="true">·</span>{text.heroTitle}
      </h1>
      <p class="antv-hero-description">{text.heroDescription}</p>
      <QaEntry locale={locale} />
    </div>
  </section>

  <section class="antv-signal" aria-labelledby="antv-updates-title" data-antv-scene>
    <h2 id="antv-updates-title" class="antv-visually-hidden">{text.updatesTitle}</h2>
    <div class="antv-signal-inner">
      <div class="antv-metrics" data-antv-item>
        {metrics.map((metric) => (
          <div class="antv-metric">
            <p><strong>{metric.value}</strong><span>{metric.suffix}</span></p>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
      <div class="antv-update-grid">
        {updates.map((item, index) => (
          <a
            class:list={['antv-update-card', index === 0 && 'antv-update-featured']}
            href={item.href}
            target="_blank"
            rel="noreferrer"
            data-antv-item
            style={`--antv-index:${index}`}
          >
            <span class="antv-update-visual"><img src={updateVisuals[index]} alt="" aria-hidden="true" loading={index === 0 ? 'eager' : 'lazy'} /></span>
            <span class="antv-update-copy">
              <small>{item.label}</small>
              <strong>{item.title[locale]}</strong>
              <span>{item.description[locale]}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="ai-solutions" class="antv-ai-solutions" aria-labelledby="antv-ai-title" data-antv-scene>
    <img class="antv-ai-background" src={aiBackground} alt="" aria-hidden="true" loading="lazy" />
    <div class="antv-ai-atmosphere" aria-hidden="true">
      <span class="antv-ai-deco antv-ai-deco-column"><img src={columnVisual} alt="" loading="lazy" /></span>
      <span class="antv-ai-deco antv-ai-deco-pie"><img src={pieVisual} alt="" loading="lazy" /></span>
      <span class="antv-ai-deco antv-ai-deco-treemap"><img src={treemapVisual} alt="" loading="lazy" /></span>
      <span class="antv-ai-deco antv-ai-deco-soft"></span>
      <span class="antv-ai-deco antv-ai-deco-ghost"></span>
    </div>
    <div class="antv-section-inner">
      <header class="antv-section-heading" data-antv-item>
        <h2 id="antv-ai-title">{text.aiTitle}</h2>
        <p>{text.aiDescription}</p>
      </header>
      <div class="antv-solution-grid">
        {aiSolutions.map((item, index) => (
          <a
            class="antv-solution-card"
            href={item.href}
            target="_blank"
            rel="noreferrer"
            data-antv-item
            style={`--antv-index:${index}`}
          >
            <span class="antv-solution-topline">
              <strong>{item.label}</strong>
              <span class="antv-solution-icon"><img src={solutionVisuals[item.label || '']} alt="" aria-hidden="true" loading="lazy" /></span>
            </span>
            <span class="antv-solution-title">{item.title[locale]}</span>
            <span class="antv-solution-description">{item.description[locale]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="products" class="antv-showcase" aria-labelledby="antv-performance-title" data-antv-scene>
    <div class="antv-section-atmosphere" aria-hidden="true">
      {showcaseDecorations.map((decoration, index) => (
        <span class={`antv-section-deco antv-showcase-decoration antv-showcase-decoration-${index + 1}`}>
          <img src={decoration} alt="" loading="lazy" />
        </span>
      ))}
    </div>
    <div class="antv-section-inner">
      <header class="antv-section-heading" data-antv-item>
        <h2 id="antv-performance-title">{text.performanceTitle}</h2>
        <p>{text.performanceDescription}</p>
      </header>
      <div class="antv-showcase-grid">
        {showcases.map((item, index) => (
          <a
            class:list={['antv-showcase-card', item.size === 'featured' && 'antv-showcase-card-featured']}
            href={item.href}
            target="_blank"
            rel="noreferrer"
            data-antv-item
            style={`--antv-index:${index}`}
          >
            <figure class:list={['antv-showcase-media', item.preview, item.mediaTone === 'dark' && 'antv-showcase-media-dark']}>
              <div class="antv-showcase-media-inner">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={isZh ? `${item.product} ${item.title.zh}示例` : `${item.product} ${item.title.en} example`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <img src={infographicVisual} alt={item.title[locale]} loading="lazy" decoding="async" />
                )}
              </div>
            </figure>
            <span class="antv-showcase-copy">
              <span class="antv-showcase-title-row"><strong>{item.title[locale]}</strong><small>{item.product}</small></span>
              <span>{item.description[locale]}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="antv-matrix" aria-labelledby="antv-matrix-title" data-antv-scene>
    <div class="antv-section-atmosphere" aria-hidden="true">
      {matrixDecorations.map((decoration, index) => (
        <span
          class={`antv-section-deco antv-matrix-decoration antv-matrix-decoration-${index + 1}`}
          set:html={decoration}
        ></span>
      ))}
    </div>
    <div class="antv-section-inner">
      <header class="antv-section-heading" data-antv-item>
        <h2 id="antv-matrix-title">{text.matrixTitle}</h2>
        <p>{text.matrixDescription}</p>
      </header>
      <div class="antv-matrix-board" data-antv-item>
        <a class="antv-matrix-sive" href={ecosystem[0].href} target="_blank" rel="noreferrer">
          <img src={siveVisual} alt="" aria-hidden="true" loading="lazy" />
          <strong>{ecosystem[0].name}</strong>
          <span>{ecosystem[0].description[locale]}</span>
          <span class="antv-link-icon" aria-hidden="true" set:html={arrowUpRightIcon}></span>
        </a>
        <div class="antv-matrix-agent">
          <strong>{text.aiAgent}</strong>
          <div>
            {aiSolutions.map((item) => (
              <a href={item.href} target="_blank" rel="noreferrer"><b>{item.label}</b><span>{item.title[locale]}</span></a>
            ))}
          </div>
        </div>
        <div class="antv-matrix-group">
          <span>{text.ecosystem}</span>
          <div class="antv-matrix-ecosystem">
            {ecosystem.slice(1).map((item) => (
              <a href={item.href} target="_blank" rel="noreferrer"><strong>{item.name}</strong><span>{item.description[locale]}</span></a>
            ))}
          </div>
        </div>
        <div class="antv-matrix-group">
          <span>{text.foundation}</span>
          <div class="antv-matrix-foundation">
            {foundation.map(([name, zhDescription, enDescription, href]) => (
              <a href={href} target="_blank" rel="noreferrer"><strong>{name}</strong><span>{isZh ? zhDescription : enDescription}</span></a>
            ))}
          </div>
        </div>
        <a class="antv-matrix-design" href={`/${locale}/specification/principles/basic/`}>
          <strong>{text.designLanguage}</strong><span class="antv-link-icon" aria-hidden="true" set:html={arrowUpRightIcon}></span>
        </a>
      </div>
    </div>
  </section>

  <section class="antv-experts" aria-labelledby="antv-experts-title" data-antv-scene>
    <div class="antv-section-inner">
      <header class="antv-section-heading antv-section-heading-compact" data-antv-item>
        <h2 id="antv-experts-title">{text.expertsTitle}</h2>
      </header>
      <div
        class="antv-expert-carousel"
        data-expert-carousel
        data-page-label={isZh ? '查看第 {page} 组专家之声' : 'View expert voices group {page}'}
        aria-roledescription={isZh ? '轮播图' : 'carousel'}
        aria-label={text.expertsTitle}
      >
        <div class="antv-expert-list" data-expert-track role="list" tabindex="0">
          {experts.map((expert, index) => (
            <article class="antv-expert-card" role="listitem" data-antv-item style={`--antv-index:${index}`}>
              <div class="antv-expert-person">
                <img src={expert.image} alt={expert.name} loading="lazy" decoding="async" />
                <div><h3>{expert.name}</h3><p>{expert.role[locale]}</p></div>
              </div>
              <blockquote>{expert.quote[locale]}</blockquote>
            </article>
          ))}
        </div>
        <div class="antv-expert-pagination" data-expert-pagination hidden></div>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-expert-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('[data-expert-track]');
      const pagination = carousel.querySelector('[data-expert-pagination]');
      const cards = [...carousel.querySelectorAll('.antv-expert-card')];
      if (!(track instanceof HTMLElement) || !(pagination instanceof HTMLElement) || !cards.length) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobile = window.matchMedia('(max-width: 767px)');
      const tablet = window.matchMedia('(min-width: 768px) and (max-width: 1000px)');
      const compactDesktop = window.matchMedia('(min-width: 1001px) and (max-width: 1199px)');
      const pageLabel = carousel.getAttribute('data-page-label') || 'View group {page}';
      let activePage = 0;
      let autoTimer;
      let scrollTimer;
      let userPaused = false;
      let isVisible = !('IntersectionObserver' in window);

      const perPage = () => mobile.matches ? 1 : tablet.matches ? 2 : compactDesktop.matches ? 3 : 4;
      const pageCount = () => Math.max(1, cards.length - perPage() + 1);
      const clearAuto = () => {
        if (autoTimer) window.clearInterval(autoTimer);
        autoTimer = undefined;
      };
      const updatePagination = () => {
        pagination.querySelectorAll('button').forEach((button, index) => {
          const active = index === activePage;
          button.classList.toggle('antv-expert-pagination-active', active);
          if (active) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        });
      };
      const goTo = (page, behavior = 'smooth') => {
        activePage = Math.max(0, Math.min(page, pageCount() - 1));
        const target = cards[activePage];
        const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
        track.scrollTo({
          left: Math.min(target.offsetLeft, maxScroll),
          behavior: reducedMotion.matches ? 'auto' : behavior,
        });
        updatePagination();
      };
      const startAuto = () => {
        clearAuto();
        if (reducedMotion.matches || userPaused || !isVisible || pageCount() <= 1 || document.hidden) return;
        autoTimer = window.setInterval(() => goTo((activePage + 1) % pageCount()), 5200);
      };
      const renderPagination = () => {
        const count = pageCount();
        const fragment = document.createDocumentFragment();
        for (let index = 0; index < count; index += 1) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'antv-expert-pagination-dot';
          button.setAttribute('aria-label', pageLabel.replace('{page}', String(index + 1)));
          button.addEventListener('click', () => {
            userPaused = true;
            clearAuto();
            goTo(index);
          });
          fragment.append(button);
        }
        pagination.replaceChildren(fragment);
        pagination.hidden = count <= 1;
        activePage = Math.min(activePage, count - 1);
        updatePagination();
      };
      const rebuild = () => {
        renderPagination();
        goTo(activePage, 'auto');
        startAuto();
      };

      track.addEventListener('scroll', () => {
        if (scrollTimer) window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          const maxPage = pageCount() - 1;
          let nearestPage = 0;
          let nearestDistance = Number.POSITIVE_INFINITY;
          for (let index = 0; index <= maxPage; index += 1) {
            const distance = Math.abs(cards[index].offsetLeft - track.scrollLeft);
            if (distance >= nearestDistance) continue;
            nearestDistance = distance;
            nearestPage = index;
          }
          activePage = nearestPage;
          updatePagination();
        }, 80);
      }, { passive: true });
      carousel.addEventListener('pointerenter', clearAuto);
      carousel.addEventListener('pointerleave', startAuto);
      carousel.addEventListener('focusin', clearAuto);
      carousel.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget)) return;
        startAuto();
      });
      carousel.addEventListener('touchstart', () => {
        userPaused = true;
        clearAuto();
      }, { passive: true });
      [mobile, tablet, compactDesktop, reducedMotion].forEach((query) => query.addEventListener('change', rebuild));
      document.addEventListener('visibilitychange', startAuto);

      if ('IntersectionObserver' in window) {
        const carouselObserver = new IntersectionObserver(([entry]) => {
          isVisible = entry.isIntersecting;
          if (isVisible) startAuto();
          else clearAuto();
        }, { threshold: 0.2 });
        carouselObserver.observe(carousel);
      }
      rebuild();
    });

    const sections = [...document.querySelectorAll('[data-antv-scene]')];
    const reveal = (section) => section.setAttribute('data-antv-visible', '');
    document.documentElement.classList.add('antv-home-motion');
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sections.forEach(reveal);
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        reveal(entry.target);
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    sections.forEach((section, index) => index === 0 ? reveal(section) : observer.observe(section));
  })();
</script>

<style>
  .antv-home {
    --antv-home-width: min(1180px, calc(100% - 64px));
    --antv-card-radius: 18px;
    --antv-card-padding: 15px;
    --antv-inner-radius: 12px;
    --antv-page: #fbfaff;
    --antv-page-rgb: 251 250 255;
    --antv-section: #f5f1ff;
    --antv-card: rgb(255 254 255 / 92%);
    --antv-card-solid: #F8F7FD;
    --antv-line: #e7ddf6;
    --antv-purple-line: #d8c3ff;
    --antv-shadow: 0 16px 42px rgb(88 49 156 / 9%);
    --antv-shadow-hover: 0 22px 50px rgb(88 49 156 / 14%);
    overflow: hidden;
    color: var(--text);
    background: var(--antv-page);
  }

  .antv-section-inner,
  .antv-signal-inner {
    width: var(--antv-home-width);
    margin: 0 auto;
  }

  .antv-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .antv-hero {
    position: relative;
    display: flex;
    min-height: 577px;
    justify-content: center;
    overflow: hidden;
    background: #eee7ff;
  }

  .antv-hero::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 5%) 0%, rgb(255 255 255 / 10%) 68%, rgb(251 250 255 / 22%) 100%);
    content: '';
    pointer-events: none;
  }

  .antv-hero-media,
  .antv-hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .antv-hero-media img {
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .antv-hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(820px, calc(100% - 40px));
    align-items: center;
    flex-direction: column;
    padding-top: clamp(48px, 4.2vw, 60px);
    text-align: center;
  }

  .antv-hero h1,
  .antv-section-heading h2 {
    margin: 0;
    color: #17141d;
    letter-spacing: -.04em;
  }

  .antv-home h1,
  .antv-home h2 {
    font-weight: var(--font-heading-weight, 900);
  }

  .antv-hero h1 {
    max-width: 100%;
    font-size: clamp(58px, 5vw, 68px);
    line-height: 1.08;
    white-space: nowrap;
  }

  .antv-wordmark {
    color: var(--brand);
  }

  .antv-hero-description {
    max-width: 660px;
    margin: 16px 0 0;
    color: #625c6c;
    font-size: 16px;
    line-height: 1.65;
  }

  .antv-update-card:focus-visible,
  .antv-solution-card:focus-visible,
  .antv-showcase-card:focus-visible,
  .antv-matrix-board a:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--brand) 50%, transparent);
    outline-offset: 3px;
  }

  .antv-signal {
    position: relative;
    z-index: 3;
    margin-top: -116px;
    padding-bottom: 82px;
    background: transparent;
  }

  .antv-signal::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--antv-page-rgb) / 0%) 0,
      rgb(var(--antv-page-rgb) / 72%) 112px,
      var(--antv-page) 190px
    );
    content: '';
    pointer-events: none;
  }

  .antv-signal-inner {
    position: relative;
    z-index: 1;
  }

  .antv-metrics {
    display: grid;
    width: min(900px, 100%);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 auto;
  }

  .antv-metric {
    position: relative;
    min-height: 164px;
    padding: 42px 28px 36px;
    text-align: center;
  }

  .antv-metric + .antv-metric::before {
    position: absolute;
    top: 30px;
    bottom: 30px;
    left: 0;
    border-left: 1px solid color-mix(in srgb, var(--brand) 14%, var(--antv-line));
    content: '';
  }

  .antv-metric p {
    margin: 0;
    color: var(--brand);
    line-height: 1;
  }

  .antv-metric strong {
    font-size: clamp(52px, 4.35vw, 62px);
    font-weight: 700;
    letter-spacing: -.04em;
  }

  .antv-metric p span {
    margin-left: 7px;
    font-size: 16px;
    font-weight: 700;
  }

  .antv-metric > span {
    display: block;
    margin-top: 13px;
    color: var(--muted);
    font-size: 14px;
  }

  .antv-update-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 50px;
  }

  .antv-update-card,
  .antv-solution-card,
  .antv-showcase-card {
    color: inherit;
